# --- обязательно ---
BOT_TOKEN=123            # от @BotFather
CRYPTOPAY_TOKEN=123                   # @CryptoBot -> Crypto Pay -> Create App -> API Token
ADMIN_IDS=123                # твой Telegram ID (через запятую, если несколько)

# --- база ---
# На Render: Internal Database URL из созданного Postgres. Локально можно не задавать (SQLite).
DATABASE_URL=

# --- продажа ---
PRICE_PER_PROXY=0.2                  # цена за ОДИН прокси
ASSET=USDT
PACK_SIZES=1,5,10,15                  # какие количества можно купить
SAMPLE_SIZE=1                      # бесплатный пример (0 — выключить)
REPLACE_MINUTES=60                 # сколько минут действует замена нерабочих

# --- тестовая сеть Crypto Pay (токен от @CryptoTestnetBot) ---
CRYPTOPAY_TESTNET=false

# --- тонкая настройка (можно не трогать) ---
FETCH_LIMIT=3000
FETCH_INTERVAL=600
CYCLE_SECONDS=60
CHECK_BATCH=1500
CHECK_CONCURRENCY=150
CHECK_TIMEOUT=8
FRESH_MINUTES=20
# доп. источники txt: протокол|ссылка, через запятую
EXTRA_SOURCES=
